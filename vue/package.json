{
  "name": "vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,js,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,vue,css,html}\"",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.14.1",
    "prettier": "^3.7.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.1.4"
  }
}
